{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "codememes",
  "account_id": "4bacc773067c830100ed4460f64332b1",
  "workers_dev": true,
  "preview_urls": false,
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-04",
  "observability": { "enabled": true },
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "ratelimits": [
    { "name": "CREATE_RATE", "namespace_id": "10001", "simple": { "limit": 10, "period": 60 } },
    { "name": "JOIN_RATE", "namespace_id": "10002", "simple": { "limit": 30, "period": 60 } },
    { "name": "COMMAND_RATE", "namespace_id": "10003", "simple": { "limit": 60, "period": 60 } },
  ],
}
